# Firebase web config. Copy this file to .env.local and fill in the values from
# Firebase console > Project settings > Your apps > Web app > SDK setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to talk to the local emulators instead of the real project.
# Run them with `npm run emulators`. Emulator data lives in ./emulator-data and
# is never touched by the live database.
VITE_USE_EMULATORS=false
